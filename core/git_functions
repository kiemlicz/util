#!/usr/bin/env zsh

git_untracked() {
  git ls-files . --exclude-standard --others
}

mrepo_branch_del() {
  local base_dir="$1"
  local branch_to_remove="$2"
  if [ -z "${branch_to_remove}" ]; then
    echo "Usage: $0 <base_dir> <branch_to_remove>"
    return 4
  fi
  echo "Branch: $branch_to_remove removal in all repositories under: $base_dir"
  for dir in "$base_dir"/*/; do
    if [ -d "$dir/.git" ]; then
      echo "Removing branch $branch_to_remove in $dir"
      (cd "$dir" && git branch -d "$branch_to_remove")
    fi
  done
}

mrepo_branch_create() {
  local repo="$1"
  local branch_name="$2"

  if [ -z "$branch_name" ] || [ -z "$repo" ]; then
    echo "Error: Branch name is required."
    echo "Usage: $0 <repo> <branch_name>"
    return 12
  fi

  pushd "$repo" >/dev/null || return 13
  local rc=0
  git checkout -b "$branch_name" || rc=$?
  popd >/dev/null || return 13
  return $rc
}

# ==============================================================================
# MULTI-WORKSPACE GIT WORKTREE SUITE ("Bare Hub + Sibling Worktrees")
# Safe to source across multiple environments. Respects external WORKSPACE_DIRS
# (array or colon-separated string) and WORKSPACE_DIR.
# ==============================================================================

_wt_get_workspaces() {
  local -a result

  if (( ${+WORKSPACE_DIRS} )); then
    if [[ "${(t)WORKSPACE_DIRS}" == *array* ]]; then
      result=( "${WORKSPACE_DIRS[@]}" )
    elif [[ -n "$WORKSPACE_DIRS" ]]; then
      result=( "${(@s/:/)WORKSPACE_DIRS}" )
    fi
  fi

  if (( ${#result} == 0 )) && [[ -n "${WORKSPACE_DIR:-}" ]]; then
    result=( "${(@s/:/)WORKSPACE_DIR}" )
  fi

  if (( ${#result} == 0 )); then
    result=( "$HOME/workspace" )
  fi

  local -aU clean_result
  for ws in "${result[@]}"; do
    [[ -n "$ws" ]] && clean_result+=( "${ws%/}" )
  done

  reply=( "${clean_result[@]}" )
}

_wt_sanitize_dir() {
  echo "${1//\//-}"
}

_wt_find_repo_dir() {
  local repo="$1"
  local -a reply
  _wt_get_workspaces
  for ws in "${reply[@]}"; do
    if [[ -d "$ws/$repo/.bare" ]]; then
      echo "$ws/$repo"
      return 0
    fi
  done
  return 1
}

_wt_find_feature_dir() {
  local feat_name="$1"
  local -a reply
  _wt_get_workspaces
  for ws in "${reply[@]}"; do
    if [[ -d "$ws/_features/$feat_name" ]]; then
      echo "$ws/_features/$feat_name"
      return 0
    fi
  done
  return 1
}

# 1. Clone a repository into the Bare Hub layout
# Usage: wt-clone [-w <workspace-dir>] <git-url> [custom-repo-name]
wt-clone() {
  local -a reply
  _wt_get_workspaces
  local target_ws="${reply[1]}"

  if [[ "$1" == "-w" && -n "$2" ]]; then
    target_ws="${2%/}"
    shift 2
  fi

  if [[ -z "$1" ]]; then
    echo "Usage: wt-clone [-w <workspace-path>] <git-url> [repo-name]"
    return 1
  fi

  local url="$1"
  local name="${2:-$(basename "$url" .git)}"
  local repo_dir="$target_ws/$name"

  local existing
  if existing=$(_wt_find_repo_dir "$name"); then
    echo "Error: Repo '$name' already exists at $existing"
    return 1
  fi

  mkdir -p "$repo_dir" && cd "$repo_dir" || return 1

  echo "-> Cloning bare repository into $repo_dir/.bare..."
  git clone --bare "$url" .bare || return 1
  echo "gitdir: ./.bare" > .git

  git config remote.origin.fetch "+refs/heads/*:refs/remotes/origin/*"
  git fetch origin --quiet
  git remote set-head origin -a >/dev/null 2>&1

  local default_branch
  default_branch=$(git symbolic-ref --short HEAD)
  local wt_dir=$(_wt_sanitize_dir "$default_branch")

  echo "-> Creating primary worktree: $wt_dir (branch: $default_branch)..."
  git worktree add "$wt_dir" "$default_branch"
  git -C "$wt_dir" branch --set-upstream-to="origin/$default_branch" "$default_branch"

  cd "$wt_dir" || return 1
  echo "Ready: $(pwd)"
}

# 2. Create or open a physical worktree
# Usage: wt-add <repo-name> <branch-name> [base-branch]
wt-add() {
  if [[ $# -lt 2 ]]; then
    echo "Usage: wt-add <repo-name> <branch-name> [base-branch]"
    return 1
  fi

  local repo="$1"
  local branch="$2"
  local base_branch="$3"
  local -a reply
  _wt_get_workspaces

  local repo_dir
  repo_dir=$(_wt_find_repo_dir "$repo") || {
    echo "Error: Repo '$repo' not found in configured workspaces (${reply[*]})."
    return 1
  }

  local wt_name=$(_wt_sanitize_dir "$branch")
  local wt_dir="$repo_dir/$wt_name"

  if [[ -d "$wt_dir" ]]; then
    echo "-> Worktree already exists: $wt_dir"
    return 0
  fi

  git -C "$repo_dir" fetch origin --quiet

  if [[ -z "$base_branch" ]]; then
    base_branch=$(git -C "$repo_dir" symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null | sed 's@^origin/@@')
    [[ -z "$base_branch" ]] && base_branch=$(git -C "$repo_dir" symbolic-ref --short HEAD)
  fi

  if git -C "$repo_dir" show-ref --verify --quiet "refs/heads/$branch"; then
    echo "-> Checking out existing local branch '$branch' into $wt_dir..."
    git -C "$repo_dir" worktree add "$wt_dir" "$branch"
  elif git -C "$repo_dir" show-ref --verify --quiet "refs/remotes/origin/$branch"; then
    echo "-> Tracking remote branch 'origin/$branch' in $wt_dir..."
    git -C "$repo_dir" worktree add --track -b "$branch" "$wt_dir" "origin/$branch"
  else
    echo "-> Creating new branch '$branch' from 'origin/$base_branch' in $wt_dir..."
    git -C "$repo_dir" worktree add --no-track -b "$branch" "$wt_dir" "origin/$base_branch"
    git -C "$wt_dir" config push.autoSetupRemote true
  fi
}

# 2b. Create/open a single-repo worktree and cd directly into it
# Usage: wt-go <repo-name> <branch-name> [base-branch]
wt-go() {
  wt-add "$@" || return 1
  local repo_dir=$(_wt_find_repo_dir "$1")
  cd "$repo_dir/$(_wt_sanitize_dir "$2")" || return 1
}

# 3. Remove a single-repo physical worktree
# Usage: wt-rm <repo-name> <branch-name> [-D]
wt-rm() {
  if [[ $# -lt 2 ]]; then
    echo "Usage: wt-rm <repo-name> <branch-name> [-D]"
    return 1
  fi

  local repo="$1"
  local branch="$2"
  local delete_branch="$3"
  local repo_dir
  repo_dir=$(_wt_find_repo_dir "$repo") || {
    echo "Error: Repo '$repo' not found."
    return 1
  }

  local wt_name=$(_wt_sanitize_dir "$branch")
  local wt_dir="$repo_dir/$wt_name"

  if [[ "$PWD/" == "$wt_dir/"* ]]; then
    cd "$repo_dir" || cd "$HOME"
  fi

  echo "-> Removing worktree $wt_dir..."
  git -C "$repo_dir" worktree remove "$wt_dir" || return 1
  git -C "$repo_dir" worktree prune

  if [[ "$delete_branch" == "-D" ]]; then
    echo "-> Deleting local branch '$branch'..."
    git -C "$repo_dir" branch -D "$branch"
  fi
}

# 4. Create a Multi-Repo Feature View
# Usage: wt-feature <branch-name> <repo1> <repo2> ...
wt-feature() {
  if [[ $# -lt 2 ]]; then
    echo "Usage: wt-feature <branch-name> <repo1> [repo2 ...]"
    return 1
  fi

  local branch="$1"; shift
  local feat_name=$(_wt_sanitize_dir "$branch")
  local -a reply
  _wt_get_workspaces

  local first_repo_dir=$(_wt_find_repo_dir "$1")
  local base_ws="${first_repo_dir:h}"
  [[ -z "$base_ws" || ! -d "$base_ws" ]] && base_ws="${reply[1]}"

  local feat_dir="$base_ws/_features/$feat_name"
  mkdir -p "$feat_dir"

  for repo in "$@"; do
    wt-add "$repo" "$branch" || continue
    local repo_dir=$(_wt_find_repo_dir "$repo")
    local wt_name=$(_wt_sanitize_dir "$branch")
    ln -sfn "$repo_dir/$wt_name" "$feat_dir/$repo"
    echo "-> Linked $feat_dir/$repo -> $repo_dir/$wt_name"
  done

  if [[ ! -f "$feat_dir/CLAUDE.md" ]]; then
    {
      echo "# Cross-Repo Feature: $branch"
      echo ""
      echo "## Repositories Involved"
      for repo in "$@"; do
        echo "- \`./$repo\` (branch: \`$branch\` — Read \`./$repo/CLAUDE.md\` before modifying)"
      done
      echo ""
      echo "## Objective & Architectural Invariants"
      echo "- "
    } > "$feat_dir/CLAUDE.md"
    ln -sfn "CLAUDE.md" "$feat_dir/AGENTS.md"
  fi

  cd "$feat_dir" || return 1
  echo "Unified feature view ready: $(pwd)"
}

# 4b. Add a repo worktree (on any branch) to an existing Multi-Repo Feature View
# Usage:
#   From inside _features/<feat>:  wt-feature-add <repo-name> [branch-name] [base-branch]
#   From anywhere:                 wt-feature-add <feature-name> <repo-name> [branch-name] [base-branch]
wt-feature-add() {
  local feat_input repo branch base_branch feat_name feat_dir

  # Context-aware: if already inside a _features/<name> directory, 1st arg can be the repo name
  if [[ "$PWD" == *"/_features/"* ]] && _wt_find_repo_dir "$1" >/dev/null 2>&1; then
    feat_dir="${PWD%/_features/*}/_features/${${PWD#*/_features/}%%/*}"
    feat_name="${feat_dir:t}"
    repo="$1"
    branch="${2:-$feat_name}"
    base_branch="$3"
  else
    if [[ $# -lt 2 ]]; then
      echo "Usage: wt-feature-add [feature-name] <repo-name> [branch-name] [base-branch]"
      return 1
    fi
    feat_input="$1"
    repo="$2"
    branch="${3:-$feat_input}"
    base_branch="$4"
    feat_name=$(_wt_sanitize_dir "$feat_input")
    feat_dir=$(_wt_find_feature_dir "$feat_name") || {
      echo "Error: Feature view '$feat_name' not found. Create it first with wt-feature."
      return 1
    }
  fi

  wt-add "$repo" "$branch" "$base_branch" || return 1

  local repo_dir=$(_wt_find_repo_dir "$repo")
  local wt_name=$(_wt_sanitize_dir "$branch")
  local target_wt="$repo_dir/$wt_name"

  # Avoid overwriting if this repo already has another branch linked in this feature
  local link_name="$repo"
  if [[ -L "$feat_dir/$link_name" ]]; then
    local existing_target=$(readlink -f "$feat_dir/$link_name")
    if [[ "$existing_target" != "$target_wt" ]]; then
      link_name="${repo}--${wt_name}"
    fi
  fi

  ln -sfn "$target_wt" "$feat_dir/$link_name"
  echo "-> Linked $feat_dir/$link_name -> $target_wt"

  local doc_file="$feat_dir/CLAUDE.md"
  [[ ! -f "$doc_file" && -f "$feat_dir/AGENTS.md" ]] && doc_file="$feat_dir/AGENTS.md"
  if [[ -f "$doc_file" ]] && ! grep -q "\`./$link_name\`" "$doc_file"; then
    # Insert under "## Repositories Involved" if present, otherwise append
    if grep -q "^## Objective" "$doc_file"; then
      sed -i "/^## Objective/i - \`./$link_name\` (branch: \`$branch\` — Read \`./$link_name/CLAUDE.md\` before modifying)" "$doc_file"
    else
      echo "- \`./$link_name\` (branch: \`$branch\` — Read \`./$link_name/CLAUDE.md\` before modifying)" >> "$doc_file"
    fi
  fi
}

# 5. Teardown a Multi-Repo Feature View (Supports mixed-branch symlinks)
# Usage: wt-feature-rm <feature-name> [-D]
wt-feature-rm() {
  if [[ -z "$1" ]]; then
    echo "Usage: wt-feature-rm <feature-name> [-D]"
    return 12
  fi

  local feat_input="$1"
  local delete_flag="$2"
  local feat_name=$(_wt_sanitize_dir "$feat_input")
  local feat_dir
  feat_dir=$(_wt_find_feature_dir "$feat_name") || {
    echo "Error: Feature view '$feat_name' not found in any workspace."
    return 1
  }

  local -a reply
  _wt_get_workspaces
  if [[ "$PWD/" == "$feat_dir/"* ]]; then
    cd "${reply[1]}" || cd "$HOME"
  fi

  for link in "$feat_dir"/*(N@); do
    [[ "${link:t}" == "AGENTS.md" || "${link:t}" == "CLAUDE.md" ]] && continue
    local target=$(readlink -f "$link")
    local repo_dir=$(dirname "$target")
    local repo_name=$(basename "$repo_dir")
    local wt_basename=$(basename "$target")

    # Never delete the repository's default branch worktree (e.g. main/master) if linked for reference
    local default_branch=$(git -C "$repo_dir" symbolic-ref --short HEAD 2>/dev/null)
    if [[ "$wt_basename" == "$(_wt_sanitize_dir "$default_branch")" ]]; then
      echo "-> Unlinking default branch worktree '$target' (leaving physical files intact)"
      continue
    fi

    local actual_branch=$(git -C "$target" branch --show-current 2>/dev/null)
    wt-rm "$repo_name" "${actual_branch:-$wt_basename}" "$delete_flag"
  done

  rm -rf "$feat_dir"
  echo "Removed feature view: $feat_dir"
}

# 6. Interactive FZF Switcher across all workspaces
wt-cd() {
  if ! command -v fzf >/dev/null 2>&1; then
    echo "Error: fzf is required for wt-cd."
    return 1
  fi

  local -a reply
  _wt_get_workspaces

  local target
  target=$(
    {
      for ws in "${reply[@]}"; do
        if [[ -d "$ws/_features" ]]; then
          find "$ws/_features" -mindepth 1 -maxdepth 1 -type d 2>/dev/null
        fi
        for bare_dir in "$ws"/*/.bare(N/); do
          local repo_dir="${bare_dir:h}"
          git -C "$repo_dir" worktree list --porcelain | awk '/^worktree / {print substr($0, 10)}' | grep -v '\.bare$'
        done
      done
    } | fzf --prompt="Worktree > " --height=40% --layout=reverse --border --preview="ls -la {}"
  )

  if [[ -n "$target" ]]; then
    cd "$target" || return 1
  fi
}

# 7. Overview of all active worktrees across all workspaces
wt-ls() {
  local -a reply
  _wt_get_workspaces

  for ws in "${reply[@]}"; do
    [[ ! -d "$ws" ]] && continue
    echo "\033[1;32m================ WORKSPACE: $ws ================\033[0m"
    for bare_dir in "$ws"/*/.bare(N/); do
      local repo_dir="${bare_dir:h}"
      echo "\033[1;34m=== ${repo_dir:t} ===\033[0m"
      git -C "$repo_dir" worktree list | grep -v '\.bare '
      echo ""
    done
    if [[ -d "$ws/_features" && -n "$(ls -A "$ws/_features" 2>/dev/null)" ]]; then
      echo "\033[1;35m=== Active _features Views ($ws) ===\033[0m"
      ls -1 "$ws/_features"
      echo ""
    fi
  done
}

# 8. Switch active workspace focus (or restore all)
# Usage: wt-ws [workspace-name-or-path | --all]
wt-ws() {
  if (( ! ${+_WT_ALL_WORKSPACES} )); then
    local -a reply
    _wt_get_workspaces
    typeset -g -a _WT_ALL_WORKSPACES
    _WT_ALL_WORKSPACES=( "${reply[@]}" )
  fi

  if [[ "$1" == "--all" || "$1" == "-a" ]]; then
    WORKSPACE_DIRS=( "${_WT_ALL_WORKSPACES[@]}" )
    echo "-> Active workspaces restored to all: ${WORKSPACE_DIRS[*]}"
    return 0
  fi

  local target="$1"
  if [[ -z "$target" ]]; then
    if command -v fzf >/dev/null 2>&1; then
      target=$(printf "%s\n" "${_WT_ALL_WORKSPACES[@]}" "ALL (Unified)" | \
        fzf --prompt="Select Workspace > " --height=25% --layout=reverse --border)
      [[ -z "$target" ]] && return 0
      if [[ "$target" == "ALL (Unified)" ]]; then
        wt-ws --all
        return 0
      fi
    else
      echo "Current active workspaces: ${_WT_ALL_WORKSPACES[*]}"
      echo "Usage: wt-ws <workspace-path> | --all"
      return 1
    fi
  else
    for ws in "${_WT_ALL_WORKSPACES[@]}"; do
      if [[ "$ws" == "$target" || "${ws:t}" == "$target" ]]; then
        target="$ws"
        break
      fi
    done
  fi

  mkdir -p "$target"
  WORKSPACE_DIRS=( "${target%/}" )
  cd "$target" || return 1
  echo "-> Focused workspace: $target (run 'wt-ws --all' to show all again)"
}
